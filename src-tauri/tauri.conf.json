{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "舒展",
  "version": "0.4.0",
  "identifier": "com.shuzhan.wellness",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "舒展 · 工作健康提醒",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600,
        "backgroundThrottling": "disabled",
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "companion",
        "title": "舒展精灵",
        "url": "companion.html",
        "width": 76,
        "height": 76,
        "minWidth": 76,
        "minHeight": 76,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
